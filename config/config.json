{
  "server": {
    "http_host": "127.0.0.1",
    "http_port": 8080,
    "socks5_host": "127.0.0.1",
    "socks5_port": 1080,
    "web_port": 5000,
    "connect_timeout_seconds": 10,
    "request_timeout_seconds": 30,
    "idle_timeout_seconds": 60
  },
  "rotation": {
    "max_rotations": 5,
    "default_rotation_count": 10,
    "strategy": "cycle",
    "shuffle_on_restart": true
  },
  "health_check": {
    "enabled": true,
    "interval_seconds": 60,
    "timeout_seconds": 10,
    "test_url": "http://httpbin.org/ip",
    "max_failures": 3
  },
  "proxy_defaults": {
    "timeout": 10,
    "max_retries": 3,
    "retry_delay": 1,
    "max_failures_before_dead": 3
  },
  "logging": {
    "level": "INFO",
    "file": "logs/proxsr.log",
    "max_bytes": 10485760,
    "backup_count": 5
  }
}
